			MX8MN_IOMUXC_UART3_RXD_GPIO5_IO26	0x16	// Slv AG26	Pull-dn	0-aktiv
			MX8MN_IOMUXC_UART3_TXD_GPIO5_IO27	0x16	// DIR AG27	Pull-dn	
		>;
