	pinctrl_ilock: ilock_grp {	
		fsl,pins = <
			MX8MN_IOMUXC_SAI2_RXD0_GPIO4_IO23		0x41	// E21	Ext. Interlock
		>;
	};

	pinctrl_ttl_i: ttl_i_grp {	// TTL Inputs
		fsl,pins = <
			MX8MN_IOMUXC_SAI5_RXD0_GPIO3_IO21		0x41	// D19 	TTL_I_Amp_On
			MX8MN_IOMUXC_SAI5_RXD1_GPIO3_IO22		0x41	// AG8	TTL_I_HV_On
			MX8MN_IOMUXC_SAI5_RXD2_GPIO3_IO23		0x41	// E3 	TTL_I_Remote
			MX8MN_IOMUXC_SAI5_RXD3_GPIO3_IO24		0x41	// E27	TTL_I_Switch
			MX8MN_IOMUXC_SAI5_MCLK_GPIO3_IO25		0x41	// C24	TTL_I_Frei
		>;
	};

	pinctrl_ttl_o: ttl_o_grp {	// TTL Outputs
		fsl,pins = <
			MX8MN_IOMUXC_SAI5_RXC_GPIO3_IO20		0x16	// E24	TTL_O_SumAlarm
//				// AN26	TTL_O_Amp_On	mca_gpio 0
//				// AL22	TTL_O_HV_On		mca_gpio 13
//				// AL25	TTL_O_Remote	mca_gpio 15
//				// AM25	TTL_O_Ready		mca_gpio 12
		>;
	};

	pinctrl_gpib: gpibgrp {		// GPIB
		fsl,pins = <
			MX8MN_IOMUXC_GPIO1_IO00_GPIO1_IO0		0x19		// AA1	GPIB_D1	
			MX8MN_IOMUXC_GPIO1_IO01_GPIO1_IO1		0x16		// AN4	GPIB_D2	
			MX8MN_IOMUXC_GPIO1_IO03_GPIO1_IO3		0x140		// AG14	GPIB_D3	
			MX8MN_IOMUXC_GPIO1_IO04_GPIO1_IO4		0x16		// AN5	GPIB_D4	
			MX8MN_IOMUXC_GPIO1_IO06_GPIO1_IO6		0x41		// E26	GPIB_D5	
			MX8MN_IOMUXC_GPIO1_IO07_GPIO1_IO7		0x16		// AG9	GPIB_D6	
			MX8MN_IOMUXC_GPIO1_IO08_GPIO1_IO8		0x16		// AG11	GPIB_D7	
			MX8MN_IOMUXC_GPIO1_IO09_GPIO1_IO9		0x16		// AG12	GPIB_D8	
			MX8MN_IOMUXC_GPIO1_IO10_GPIO1_IO10		0x16		// AG13	GPIB_ATN
			MX8MN_IOMUXC_GPIO1_IO11_GPIO1_IO11		0x16		// AG10	GPIB_EOI
			MX8MN_IOMUXC_GPIO1_IO12_GPIO1_IO12		0x19		// C8	GPIB_SRQ	
			MX8MN_IOMUXC_GPIO1_IO13_GPIO1_IO13		0x16		// C9	GPIB_REN	
			MX8MN_IOMUXC_GPIO1_IO14_GPIO1_IO14		0x16		// C7	GPIB_IFC
			MX8MN_IOMUXC_GPIO1_IO15_GPIO1_IO15		0x16		// C11	GPIB_DAV	

			MX8MN_IOMUXC_SD2_DATA0_GPIO2_IO15		0x16		// G1	GPIB_DC	
			MX8MN_IOMUXC_SD2_DATA1_GPIO2_IO16		0x16		// H1	GPIB_TE
			MX8MN_IOMUXC_SD2_CLK_GPIO2_IO13			0x16		// L1	GPIB_NRFD
			MX8MN_IOMUXC_SD2_CMD_GPIO2_IO14			0x16		// F1	GPIB_PE
			MX8MN_IOMUXC_SD2_CD_B_GPIO2_IO12		0x1C4		// G2	GPIB_NDAC	
			MX8MN_IOMUXC_SAI3_TXC_GPIO5_IO0			0x140		// E13	GPIB_SC	
		>;
	};

	pinctrl_gpios: gpios_grp {	// GPIO Pins
		fsl,pins = <
			MX8MN_IOMUXC_SAI2_TXFS_GPIO4_IO24		0x16	// C19 	GPIO_3V_0
			MX8MN_IOMUXC_SAI2_TXC_GPIO4_IO25		0x16	// E23 	GPIO_3V_1
			MX8MN_IOMUXC_SAI2_TXD0_GPIO4_IO26		0x16	// E20 	GPIO_3V_2
			MX8MN_IOMUXC_SAI2_MCLK_GPIO4_IO27		0x16	// B24	GPIO_3V_3
			MX8MN_IOMUXC_SAI3_RXFS_GPIO4_IO28		0x19	// E28	GPIO_3V_4
			MX8MN_IOMUXC_SAI3_RXC_GPIO4_IO29		0x16	// F12	GPIO_3V_5
			MX8MN_IOMUXC_SAI3_RXD_GPIO4_IO30		0x16	// F11	GPIO_3V_6
			MX8MN_IOMUXC_SAI3_TXFS_GPIO4_IO31		0x16	// E12	GPIO_3V_7

			MX8MN_IOMUXC_SAI3_TXD_GPIO5_IO1			0x16	// F29	GPIO_3V_8
			MX8MN_IOMUXC_ECSPI2_MOSI_GPIO5_IO11		0x16	// E18	GPIO_3V_15
			MX8MN_IOMUXC_ECSPI2_MISO_GPIO5_IO12		0x16	// E22	GPIO_3V_16
			MX8MN_IOMUXC_ECSPI2_SS0_GPIO5_IO13		0x16	// E19	GPIO_3V_17
			MX8MN_IOMUXC_UART1_RXD_GPIO5_IO22		0x16	// E17	GPIO_3V_18
			MX8MN_IOMUXC_ECSPI2_SCLK_GPIO5_IO10		0x16	// D17	GPIO_3V_22
			MX8MN_IOMUXC_SPDIF_EXT_CLK_GPIO5_IO5	0x16	// Y1	TEMP_DQ
		>;
	};


	pinctrl_uart1: uart1grp {
		fsl,pins = <
			MX8MN_IOMUXC_SAI2_RXC_UART1_DCE_RX	0x140
			MX8MN_IOMUXC_SAI2_RXFS_UART1_DCE_TX	0x140
