	pinctrl_uart4: uart4grp {	// Bus 2
		fsl,pins = <
			MX8MN_IOMUXC_UART4_RXD_UART4_DCE_RX		0x140	// U29	TP62
			MX8MN_IOMUXC_UART4_TXD_UART4_DCE_TX		0x140	// T29	TP60
