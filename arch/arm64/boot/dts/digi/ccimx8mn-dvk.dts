	pinctrl_uart2_gpios: uart2_gpiogrp {	// BUS 0
		fsl,pins = <
//			MX8MN_IOMUXC_UART1_TXD_GPIO5_IO23	0x140	// Mst D18		Pull-up	0-aktiv
