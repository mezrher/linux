	/* Bus 0 Power regulator */
	pinctrl_reg_12v_bus0: pinctrl_reg_12v_bus0grp {
		fsl,pins = <
			/* PHY power */
			MX8MN_IOMUXC_SPDIF_RX_GPIO5_IO4		0x41	// AF1 PS_EN
