/* Console */
&uart1 {
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&pinctrl_uart1>;
	pinctrl-1 = <&pinctrl_uart1_sleep>;
	status = "okay";
};

// Bus0
/*
&uart2 {
	pinctrl-names = "default";
	assigned-clocks = <&clk IMX8MN_CLK_UART2>;
	assigned-clock-parents = <&clk IMX8MN_SYS_PLL1_80M>;
	pinctrl-0 = <&pinctrl_uart2>;
//	pinctrl-0 = <&pinctrl_uart2>, <&pinctrl_uart2_gpios>;
//	pinctrl-0 = <&pinctrl_uart2_bus0>;
	fsl,uart-has-rtscts;
	status = "okay";
};
*/
// Bus0
&uart2 {
	pinctrl-names = "default";
	assigned-clocks = <&clk IMX8MN_CLK_UART2>;
	assigned-clock-parents = <&clk IMX8MN_SYS_PLL1_80M>;
//	pinctrl-0 = <&pinctrl_uart2_rs485>, <&pinctrl_uart2_rs485_re>, <&pinctrl_uart2_gpios>;
	pinctrl-0 = <&pinctrl_uart2_rs485>, <&pinctrl_uart2_rs485_re>;
	rts-gpios = <&gpio2 20 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

// Bus1
&uart3 {
	pinctrl-names = "default";
	assigned-clocks = <&clk IMX8MN_CLK_UART3>;
	assigned-clock-parents = <&clk IMX8MN_SYS_PLL1_80M>;
	pinctrl-0 = <&pinctrl_uart3_rs485>, <&pinctrl_uart3_rs485_re>;
	rts-gpios = <&gpio2 19 GPIO_ACTIVE_HIGH>;
//	rts-gpios = <&gpio5 8 GPIO_ACTIVE_HIGH>;
	status = "okay";
};


&uart4 {	// Bus 2 GPIO	Test: echo "a" > /dev/ttymxc3
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_uart4_rs485>, <&pinctrl_uart4_rs485_re>;
	assigned-clocks = <&clk IMX8MN_CLK_UART4>;
	assigned-clock-parents = <&clk IMX8MN_SYS_PLL1_80M>;
	rts-gpios = <&gpio3 19 GPIO_ACTIVE_HIGH>;
	status = "okay";
};

/* USB_OTG1 connected to usb hub */
&usbotg1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_usbotg1>;

	vbus-supply = <&reg_3v3_usb_hub>;
//	dr_mode = "host";
	dr_mode = "peripheral";
	disable-over-current;
	status = "okay";
};

/* IOMUX */
&iomuxc {
	pinctrl-names = "default";
//	pinctrl-0 = <&pinctrl_hog>;
	pinctrl-0 = <&pinctrl_uart2_gpios>, <&pinctrl_ilock>, <&pinctrl_ttl_i>, <&pinctrl_ttl_o>, <&pinctrl_gpib>, <&pinctrl_gpios>;
//	pinctrl-0 = <&pinctrl_uart2_gpios>, <&pinctrl_ilock>, <&pinctrl_ttl_i>, <&pinctrl_ttl_o>;

	pinctrl_hog: hoggrp {
		fsl,pins = <
			/* GPIO1_IO10 on expansion connector */
//			MX8MN_IOMUXC_GPIO1_IO10_GPIO1_IO10	0x16
			/* GPIO1_IO11 on expansion connector */
//			MX8MN_IOMUXC_GPIO1_IO11_GPIO1_IO11	0x16
			/* User LED 3 */
//			MX8MN_IOMUXC_SD2_RESET_B_GPIO2_IO19	0x16
			/* User button 2 */
//			MX8MN_IOMUXC_SD2_WP_GPIO2_IO20	0x156
			/*
			 * Expansion I2C port IRQ.
			 * Remove if you plan on using this line for a device
			 * connected to the expansion I2C port.
			 */
//			MX8MN_IOMUXC_UART3_TXD_GPIO5_IO27	0x16
			/*
			 * Expansion I2C port GPIO.
			 * Remove if you plan on using this line for a device
			 * connected to the expansion I2C port.
			 */
//			MX8MN_IOMUXC_UART3_RXD_GPIO5_IO26	0x16
		>;
	};

	pinctrl_fec1_gpio: fec1gpiogrp {
		fsl,pins = <
			/* PHY reset */
			//MX8MN_IOMUXC_SPDIF_TX_GPIO5_IO3		0x19
			/* PHY interrupt */
			MX8MN_IOMUXC_SAI3_MCLK_GPIO5_IO2	0x19
		>;
	};

	pinctrl_fec1: fec1grp {
		fsl,pins = <
			MX8MN_IOMUXC_ENET_MDC_ENET1_MDC		0x3
			MX8MN_IOMUXC_ENET_MDIO_ENET1_MDIO	0x3
			MX8MN_IOMUXC_ENET_TD3_ENET1_RGMII_TD3	0x1f
			MX8MN_IOMUXC_ENET_TD2_ENET1_RGMII_TD2	0x1f
			MX8MN_IOMUXC_ENET_TD1_ENET1_RGMII_TD1	0x1f
			MX8MN_IOMUXC_ENET_TD0_ENET1_RGMII_TD0	0x1f
			MX8MN_IOMUXC_ENET_RD3_ENET1_RGMII_RD3	0x91
			MX8MN_IOMUXC_ENET_RD2_ENET1_RGMII_RD2	0x91
			MX8MN_IOMUXC_ENET_RD1_ENET1_RGMII_RD1	0x91
			MX8MN_IOMUXC_ENET_RD0_ENET1_RGMII_RD0	0x91
			MX8MN_IOMUXC_ENET_TXC_ENET1_RGMII_TXC	0x1f
			MX8MN_IOMUXC_ENET_RXC_ENET1_RGMII_RXC	0x91
			MX8MN_IOMUXC_ENET_RX_CTL_ENET1_RGMII_RX_CTL	0x91
			MX8MN_IOMUXC_ENET_TX_CTL_ENET1_RGMII_TX_CTL	0x1f
		>;
	};
