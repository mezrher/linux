/dts-v1/;

/*
 * The device tree for the ConnectCore 8M Nano DVK is made out of different
 * device tree include files that contain the common hardware of all variants.
 *
 * A U-Boot boot script applies additional overlays for variant-specific
 * hardware, including:
 *  - Overlay for ConnectCore 8M Nano variants with Wi-Fi
 *  - Overlay for ConnectCore 8M Nano variants with Bluetooth
 *
 * The boot script also applies a special overlay when running on
 * ConnectCore 8M Nano SOMs with hardware revision 1. This overlay changes
 * important interface configurations that are required to boot the system
 * properly on said hardware revision.
 *
 * If you are not going to use Digi's boot script, you can:
 *  - Manually add the overlays to U-Boot's "overlays" environment variable
 *  - Apply the overlay fragments manually to this device tree, if you don't
 *    use Digi U-Boot's "dboot" command
 */
/* i.MX8MN CPU */
#include "../freescale/imx8mn.dtsi"
/* Digi ConnectCore 8M Nano */
#include "ccimx8mn.dtsi"

/ {
	model = "Digi International ConnectCore 8M Nano DVK.";
	compatible = "digi,ccimx8mn-dvk", "digi,ccimx8mn", "digi,ccimx8m", "digi,ccimx8", "fsl,imx8mn";
	digi,machine,name = "ccimx8mn-dvk";

	chosen {
		bootargs = "console=ttymxc0,115200 earlycon=ec_imx6q,0x30860000,115200";
		stdout-path = &uart1;
	};


	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		reg_3v3_ext: regulator@1 {
			compatible = "regulator-fixed";
			reg = <1>;
			regulator-name = "3v3_ext";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
//			gpio = <&mca_gpio 9 GPIO_ACTIVE_HIGH>;	// AG29 RS232_RX
			enable-active-high;
			regulator-always-on;
			regulator-boot-on;
		};

		reg_1v8_ext: regulator@2 {
			compatible = "regulator-fixed";
			reg = <2>;
			regulator-name = "1v8_ext";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
//			gpio = <&mca_gpio 14 GPIO_ACTIVE_HIGH>;	// AL26 ADC4
			enable-active-high;
			regulator-always-on;
			regulator-boot-on;
		};

/*		reg_3v3_eth0: regulator@3 {
			compatible = "regulator-fixed";
			reg = <3>;
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_reg_3v3_eth0>;
			regulator-name = "3v3_eth0";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			gpio = <&gpio5 4 GPIO_ACTIVE_HIGH>;	// AF1 PS_EN
			enable-active-high;
			startup-delay-us = <10000>;
			vin-supply = <&reg_3v3_ext>;
		};*/

		reg_3v3_eth0: regulator-ethphy {
			compatible = "regulator-fixed";
			off-on-delay=<500000>;
			regulator-always-on;
			regulator-boot-on;
			
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-name = "3v3_eth0";
			startup-delay-us = <200000>;
			
		};

		// PS_EN für 12V
		reg_12v_bus0: regulator@3 {
			compatible = "regulator-fixed";
			reg = <3>;
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_reg_12v_bus0>;
			regulator-name = "3v3_eth0";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			gpio = <&gpio5 4 GPIO_ACTIVE_HIGH>;	// AF1 PS_EN
			enable-active-high;
			startup-delay-us = <10000>;
			vin-supply = <&reg_3v3_ext>;
		};

		reg_5v_board: regulator@4 {
			compatible = "regulator-fixed";
			reg = <4>;
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_reg_5v_board>;
			regulator-name = "5v_board";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
//			gpio = <&gpio1 6 GPIO_ACTIVE_HIGH>;		// E26 GPIB D5
			enable-active-high;
		};

/*		reg_3v3_audio: regulator@5 {
			compatible = "regulator-fixed";
			reg = <5>;
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_reg_3v3_aud>;
			regulator-name = "3v3_audio";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
//			gpio = <&gpio3 24 GPIO_ACTIVE_HIGH>;	// E27 TTL I Switch
			enable-active-high;
			startup-delay-us = <1000>;
			vin-supply = <&reg_3v3_ext>;
		};
*/
		reg_3v3_usb_hub: regulator@6 {
			compatible = "regulator-fixed";
			reg = <6>;
			pinctrl-names = "default";
			pinctrl-0 = <&pinctrl_reg_3v3_usb_hub>;
			regulator-name = "3v3_usb_hub";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
//			gpio = <&gpio3 25 GPIO_ACTIVE_HIGH>;	// C24 TTL I Frei
			enable-active-high;
			vin-supply = <&reg_3v3_ext>;
		};

	};

};

&cameradev {
	status = "okay";
};

&easrc {
	fsl,asrc-rate  = <48000>;
	status = "okay";
};


&fec1 {
	pinctrl-names = "default";
	pinctrl-0 = <&pinctrl_fec1_gpio>,
		    <&pinctrl_fec1>;
	phy-mode = "rgmii-id";
	phy-handle = <&ethphy0>;
	digi,mdio-lt-supply = <&reg_1v8_ext>;
	phy-supply = <&reg_3v3_eth0>;
//	phy-supply = <&reg_12v_bus0>;	// enables 12V bus0 supply; wrong place! 
	
	/* @Mezrher This will have no effect because fec reset uncomented in fec_mxc.c*/
	
	//phy-reset-gpios = <&gpio5 3 GPIO_ACTIVE_LOW>;  
	//phy-reset-duration = <1>;
	//digi,phy-reset-in-suspend;
	
       
	fsl,magic-packet;
	status = "okay";

	mdio {
		#address-cells = <1>;
		#size-cells = <0>;

		ethphy0: ethernet-phy@0 {
			compatible = "ethernet-phy-id0022.1642","ethernet-phy-ieee802.3-c22";
			reg = <0>;
		 	interrupt-parent = <&gpio5>;         
			interrupts = <2 IRQ_TYPE_LEVEL_LOW>;  
			micrel,led-mode=<1>;
		};
	};
};
