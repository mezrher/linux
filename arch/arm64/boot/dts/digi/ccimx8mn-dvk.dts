			MX8MN_IOMUXC_SAI3_RXD_UART2_DCE_RTS_B	0x140	// F11	GPIO3V_6	R181
			MX8MN_IOMUXC_SAI3_RXC_UART2_DCE_CTS_B	0x140	// F12	GPIO3V_5	R151
