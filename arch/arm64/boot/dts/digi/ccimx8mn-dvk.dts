	pinctrl_reg_3v3_board: reg_3v3_board_grp {
		fsl,pins = <
			/* GPIO3_19 board regulator enable */
//			MX8MN_IOMUXC_SAI5_RXFS_GPIO3_IO19		0x41
		>;
